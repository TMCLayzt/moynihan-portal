# Copy this file to .env for local development and fill in real values.
# .env is gitignored — never commit real secrets.
# In production these are set in the Render dashboard instead.
#
# The app refuses to start if any of the six required variables is missing,
# rather than falling back to a guessable default.

# ── Required ──────────────────────────────────────────────────────────────────

# Signs the session cookie. Any long random string.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Airtable personal access token (starts with "pat") and the base ID (starts with "app").
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# The single shared code every fellow uses to enter the portal.
# Change this each semester and give the new one to that term's fellows.
STUDENT_ACCESS_CODE=

# Tokens for the calendar subscription feeds. Treat the staff one as a secret:
# anyone holding it can read staff-only events.
ICS_PUBLIC_TOKEN=
ICS_STAFF_TOKEN=

# ── Optional ──────────────────────────────────────────────────────────────────

# The term shown throughout the portal. This is the only place it's named.
SEMESTER_LABEL=Fall 2026

# Set to "production" on the live host: enables secure cookies.
# Set to "development" locally to turn on the Flask debugger.
FLASK_ENV=production
